{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["vite/client", "bun"]
    },
    "include": ["src", "scripts/*.ts", "vite.config.ts"]
}
